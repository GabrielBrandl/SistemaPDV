<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtPayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pagamento"
        android:textColor="@color/amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPayAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R$ 0,00"
        android:textColor="@color/text"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginVertical="24dp" />

    <TextView
        android:id="@+id/txtPayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escolha a forma"
        android:textColor="@color/muted"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPix"
        style="@style/PosButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/btn_pay_pix"
        android:backgroundTint="@color/teal"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDebit"
        style="@style/PosButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/btn_pay_debit"
        android:backgroundTint="@color/blue"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCredit"
        style="@style/PosButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/btn_pay_credit"
        android:backgroundTint="@color/indigo"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Voltar"
        android:backgroundTint="@color/surface"
        android:textColor="@color/text"
        android:layout_marginTop="16dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bind ao serviço PlugPag embarcado na Moderninha / SmartPOS PagBank -->
    <uses-permission android:name="br.com.uol.pagseguro.permission.PLUGPAGSERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mercadopago" />
        </intent>
        <intent>
            <action android:name="com.mercadopago.PAYMENT" />
        </intent>
    </queries>

    <application
        android:name=".PdvApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistemaPDV"
        android:usesCleartextTraffic="false">

        <!-- Cielo Smart Deep Link: identifica o app como integração URI -->
        <meta-data
            android:name="cs_integration_type"
            android:value="uri" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App padrão de pagamento no terminal PagBank -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="payment" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.PayActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <!-- Callback Cielo Smart: order://response -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="order"
                    android:host="response" />
            </intent-filter>
            <!-- Callback Mercado Pago Point -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="pdvcashless"
                    android:host="mp-point" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ExitActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
